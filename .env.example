# ---------------------------------------------------------------------------
# LearnCode — environment variables
# Copy this file to .env.local and fill in real values. Never commit secrets.
# ---------------------------------------------------------------------------

# Public URL of the deployment. Must match the domain you use in Supabase
# Auth redirect allow-lists. No trailing slash.
NEXT_PUBLIC_APP_URL=http://localhost:3000

# Supabase project (Project Settings → API)
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# Server-only service role key. Used exclusively in server modules for
# operations that must bypass RLS: reading quiz answer keys, issuing
# certificates, recording AI quota and public certificate verification.
# NEVER expose this with a NEXT_PUBLIC_ prefix or import it in client code.
SUPABASE_SERVICE_ROLE_KEY=

# Groq (https://console.groq.com/keys). Single AI provider.
GROQ_API_KEY=

# Groq model id. The default below is Groq's current recommended production
# model (GPT-OSS 120B). See https://console.groq.com/docs/models
GROQ_MODEL=openai/gpt-oss-120b

# Hard cap on generated tokens per AI request.
AI_MAX_OUTPUT_TOKENS=1200

# Optional: upper bound for a single Groq request in milliseconds (default 45000).
# AI_REQUEST_TIMEOUT_MS=45000
